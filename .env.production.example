# Production environment template.
# Copy to `.env.production` on the prod server and fill in real values.
# NEVER commit `.env.production` — it's gitignored.

# Database — generate fresh, strong credentials (don't reuse dev's).
# e.g. openssl rand -base64 24
DB_NAME=sensuspr
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_HOST=sensuspr-db
DB_ROOT_PASSWORD=CHANGE_ME

# Email
SEND_NAME=Sensus PR
PRIMARY_EMAIL=pr@sensuspr.com
SECONDARY_EMAIL=info@sensuspr.com
SEND_EMAIL=pr@sensuspr.com

# SMTP relay — use a real transactional provider or an app-specific
# password, not a Gmail account password.
SMTP_HOST=CHANGE_ME
SMTP_PORT=465
SMTP_TLS=on
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME

# reCAPTCHA — register real keys for sensuspr.com at
# https://www.google.com/recaptcha/admin (test keys accept any domain
# and offer no real protection).
RECAPTCHA_PUBLIC_KEY=CHANGE_ME
RECAPTCHA_PRIVATE_KEY=CHANGE_ME
