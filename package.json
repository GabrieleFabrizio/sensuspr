{
  "name": "sensuspr_css",
  "version": "1.1.0",
  "description": "Scss sass implementation for sensuspr",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "watch": "sass sass/main.scss sass/CompiledSass/style.css -w",
    "compsass": "sass sass/main.scss sass/CompiledSass/style.comp.css",
    "prefix": "postcss --use autoprefixer -b 'last 10 versions' sass/CompiledSass/style.comp.css -o sass/CompiledSass/style.prefix.css",
    "compress": "minify sass/CompiledSass/style.prefix.css > template/css/style_1-x.css",
    "build": "npm-run-all compsass prefix compress"  
  },
  "author": "Gabriele Fabrizio Sbalbi",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.4.13",
    "concat": "^1.0.3",
    "minify": "^9.1.0",
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^10.0.0",
    "sass": "^1.56.0"
  }
}
